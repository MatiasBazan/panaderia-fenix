# ─────────────────────────────────────────────────────────────────────────
# Plantilla de .env para producción (Docker) — Panadería Fénix
# Copiar a .env en el VPS y completar APP_KEY + contraseñas.
#   cp .env.docker.example .env
#   docker compose run --rm app php artisan key:generate --show   # pegá el valor en APP_KEY
# ─────────────────────────────────────────────────────────────────────────

APP_NAME="Panadería Fénix"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://panaderiafenix.com
APP_TIMEZONE=America/Argentina/Cordoba

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_AR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# La base corre en el contenedor 'db' de este mismo compose.
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=panaderia_fenix
DB_USERNAME=fenix
DB_PASSWORD=CAMBIAR_por_una_clave_fuerte
# Si se omite, MySQL usa DB_PASSWORD también como root.
DB_ROOT_PASSWORD=CAMBIAR_root_clave_fuerte

# Puerto local en el host para probar con curl (no lo usa Caddy).
APP_PORT=8091

# Cargar admin + catálogo en el PRIMER arranque. Volvé a "false" luego.
RUN_SEED=true

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Detrás de Caddy (TLS): la cookie de sesión solo viaja por HTTPS.
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail: por defecto a log. Poné SMTP real si querés enviar cotizaciones por mail.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="pedidos@panaderiafenix.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Datos reales del negocio (ya usados por el front). Tienen defaults en
# config/fenix.php, así que podés dejarlos así.
FENIX_ADMIN_EMAIL="admin@panaderiafenix.com"
# WhatsApp según tipo de pedido (el público elige minorista/mayorista).
FENIX_WHATSAPP_MINORISTAS="5493472527326"   # Nati
FENIX_WHATSAPP_MAYORISTAS="5493472552461"   # Juan

# Fotos de producto: único lugar donde se toca el tamaño del catálogo.
FENIX_IMG_ANCHO_MAX=1200
FENIX_IMG_THUMB_ANCHO=400
FENIX_IMG_THUMB_ALTO=300
FENIX_IMG_CALIDAD=80
FENIX_IMG_PESO_MAX_KB=10240
